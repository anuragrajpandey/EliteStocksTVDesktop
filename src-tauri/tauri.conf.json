{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EliteStocks TV",
  "version": "0.1.0",
  "identifier": "in.elitestocks.tv.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EliteStocks TV",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Video",
    "shortDescription": "Desktop IPTV and media player",
    "longDescription": "EliteStocks TV desktop player using Tauri, WebView2, React, TypeScript, and MPV."
  }
}
